# WHAT-IF — environment template
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored (see .gitignore → `.env*` / `!.env.example`).
# NEVER commit a real key. This template must contain placeholders only.

# ---------------------------------------------------------------------------
# REQUIRED — DeepSeek API (the LLM behind all three routes)
# Read by lib/llm.ts. Without DEEPSEEK_API_KEY the app starts but every
# /api/analyze, /api/analogy and /api/crash-simulation call fails with
# `upstream_error`.
# ---------------------------------------------------------------------------

# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace-me-with-your-deepseek-key

# Optional overrides — omit both to use the defaults shown here.
# lib/llm.ts falls back to these values when the variable is unset or empty.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# OPTIONAL — IBM Bob / watsonx
#
# The WHAT-IF runtime does NOT read these: no route imports them, and the app
# runs end-to-end without them. They are listed only because the lablab.ai
# submission expects the Bob/watsonx credentials used during development to be
# documented. Leave them blank in `.env.local` unless you have a reason.
# ---------------------------------------------------------------------------

# IBM Cloud API key for the watsonx.ai project used while building with Bob.
IBM_CLOUD_API_KEY=

# watsonx.ai project ID (IBM Cloud → watsonx → Project → Manage → General).
WATSONX_PROJECT_ID=

# Region endpoint, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=

# ---------------------------------------------------------------------------
# NOTE — no GitHub token is needed.
#
# lib/github.ts calls only the public GitHub REST API (repo metadata + tree)
# for PUBLIC repos, unauthenticated. Private repos and OAuth are explicitly
# out of scope for the MVP, so there is no GITHUB_TOKEN.
# ---------------------------------------------------------------------------
